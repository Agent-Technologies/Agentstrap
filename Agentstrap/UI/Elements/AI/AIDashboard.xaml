<UserControl x:Class="Agentstrap.UI.Elements.AI.AIDashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Width="420" Height="560">
    <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}" CornerRadius="12,12,0,0" Padding="10,8" Cursor="SizeAll">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Agentstrap AI" FontWeight="SemiBold" FontSize="14" Margin="0,0,8,0" />
                        <Border x:Name="StatusDot" Width="8" Height="8" CornerRadius="4" Background="Gray" Margin="4,0" />
                        <TextBlock x:Name="StatusText" Text="Not connected" FontSize="11" Opacity="0.7" Margin="6,0,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock x:Name="SelectedModelHeader" Text="" FontSize="11" Opacity="0.85" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <Button x:Name="ResetPosButton" Content="Reset" Padding="6,2" Margin="2" Click="ResetPosButton_Click" />
                        <Button x:Name="DisableControlButton" Content="Disable Control" Padding="6,2" Margin="2" Click="DisableControlButton_Click" />
                        <Button x:Name="CloseButton" Content="X" Padding="6,2" Margin="2" Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Config row -->
            <Border Grid.Row="1" Padding="8" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ProviderCombo" Grid.Column="0" Margin="0,0,4,0" SelectionChanged="ProviderCombo_SelectionChanged" />
                        <TextBox x:Name="ModelIdBox" Grid.Column="1" Margin="4,0,0,0" Height="26" TextChanged="ModelIdBox_TextChanged" />
                    </Grid>
                    <Grid Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="ApiKeyBox" Grid.Column="0" Margin="0,0,4,0" />
                        <Button x:Name="ShowKeyButton" Grid.Column="1" Content="Show" Padding="6,2" Margin="2" Click="ShowKeyButton_Click" />
                        <Button x:Name="TestButton" Grid.Column="2" Content="Test" Padding="6,2" Margin="2" Click="TestButton_Click" />
                    </Grid>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="PermissionModeCombo" Grid.Column="0" Margin="0,0,4,0" SelectionChanged="PermissionModeCombo_SelectionChanged" />
                        <Button x:Name="SaveKeyButton" Grid.Column="1" Content="Save Key" Padding="6,2" Margin="2" Click="SaveKeyButton_Click" />
                        <Button x:Name="RemoveKeyButton" Grid.Column="2" Content="Remove" Padding="6,2" Margin="2" Click="RemoveKeyButton_Click" />
                        <Button x:Name="AIControlToggle" Grid.Column="3" Content="AI Control" Padding="6,2" Margin="2" Click="AIControlToggle_Click" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="New Chat" Padding="6,2" Margin="2" Click="NewChatButton_Click" />
                        <Button Content="Clear" Padding="6,2" Margin="2" Click="ClearButton_Click" />
                        <Button Content="Delete Conv" Padding="6,2" Margin="2" Click="DeleteConvButton_Click" />
                        <Button Content="Open .env" Padding="6,2" Margin="2" Click="OpenEnvButton_Click" />
                        <ComboBox x:Name="ConversationCombo" Width="120" Margin="4,0,0,0" SelectionChanged="ConversationCombo_SelectionChanged" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Chat area -->
            <ScrollViewer x:Name="ChatScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="8">
                <StackPanel x:Name="ChatPanel" />
            </ScrollViewer>

            <!-- Input -->
            <Border Grid.Row="3" Padding="8" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="InputBox" Grid.Column="0" Height="36" KeyDown="InputBox_KeyDown" />
                    <Button x:Name="SendButton" Grid.Column="1" Content="Send" Padding="10,6" Margin="4,0,0,0" Click="SendButton_Click" />
                    <Button x:Name="StopButton" Grid.Column="2" Content="Stop" Padding="10,6" Margin="4,0,0,0" Click="StopButton_Click" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
