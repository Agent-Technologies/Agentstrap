<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Graphite surfaces shared by settings, dialogs, cards, and controls. -->
    <Color x:Key="ApplicationBackgroundColor">#FF191C1A</Color>
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#FF191C1A" />
    <Color x:Key="CardBackgroundFillColorDefault">#FF232825</Color>
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FF232825" />
    <Color x:Key="CardBackgroundFillColorSecondary">#FF202421</Color>
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#FF202421" />
    <Color x:Key="CardStrokeColorDefault">#FF303834</Color>
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#FF303834" />
    <Color x:Key="CardStrokeColorDefaultSolid">#FF232825</Color>
    <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="#FF232825" />
    <Color x:Key="ControlStrokeColorDefault">#FF303834</Color>
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#FF303834" />
    <Color x:Key="ControlStrokeColorSecondary">#FF3A433D</Color>
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#FF3A433D" />
    <Color x:Key="SolidBackgroundFillColorBase">#FF191C1A</Color>
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#FF191C1A" />
    <Color x:Key="SolidBackgroundFillColorSecondary">#FF202522</Color>
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#FF202522" />
    <Color x:Key="SolidBackgroundFillColorTertiary">#FF272D29</Color>
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#FF272D29" />
    <Color x:Key="SolidBackgroundFillColorQuarternary">#FF2C332E</Color>
    <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="#FF2C332E" />
    <Color x:Key="DividerStrokeColorDefault">#FF303834</Color>
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#FF303834" />

    <!-- A soft green accent tuned for readable contrast on graphite surfaces. -->
    <Color x:Key="SystemAccentColor">#287A4D</Color>
    <Color x:Key="SystemAccentColorPrimary">#58B77F</Color>
    <Color x:Key="SystemAccentColorSecondary">#83D09F</Color>
    <Color x:Key="SystemAccentColorTertiary">#B9E6CA</Color>
    <SolidColorBrush x:Key="SystemAccentColorBrush" Color="#287A4D" />
    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="#58B77F" />
    <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="#83D09F" />
    <SolidColorBrush x:Key="SystemAccentColorTertiaryBrush" Color="#B9E6CA" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#58B77F" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#B9E6CA" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#83D09F" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#102217" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#80102217" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSelectedTextBrush" Color="White" />
    <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="#287A4D" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#58B77F" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#58B77F" Opacity="0.9" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#58B77F" Opacity="0.8" />
    <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="#287A4D" />
    <SolidColorBrush x:Key="NewTextEditorBackground" Color="#2D2D2D" />
    <SolidColorBrush x:Key="NewTextEditorForeground" Color="White" />
    <SolidColorBrush x:Key="NewTextEditorLink" Color="#83D09F" />
</ResourceDictionary>
