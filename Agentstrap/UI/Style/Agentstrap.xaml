<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--  Shared layout vocabulary for every settings page. Theme surfaces and
          typography resolve from WPF UI resources. Brand accents live in the
          matching Light/Dark dictionaries so contrast adapts with the theme.  -->

    <!--  =====  Spacing scale  =====  -->

    <Thickness x:Key="AgSectionMargin">0,24,0,0</Thickness>
    <Thickness x:Key="AgCardPadding">18,16</Thickness>
    <!--  ColumnDefinition.Width is a GridLength, so this has to be typed as one
          rather than reusing a Thickness.  -->
    <GridLength x:Key="AgCardGap">10</GridLength>
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>

    <!--  =====  Page chrome  =====  -->

    <Style x:Key="AgPageTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="{StaticResource Rubik}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="AgPageSubtitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="AgSectionHeader" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="{StaticResource AgSectionMargin}" />
        <Setter Property="FontFamily" Value="{StaticResource Rubik}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="AgBody" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!--  =====  Card content  =====  -->

    <Style x:Key="AgCard" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorTertiaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="{StaticResource AgCardPadding}" />
    </Style>

    <Style x:Key="AgCardMuted" TargetType="{x:Type Border}" BasedOn="{StaticResource AgCard}">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
    </Style>

    <!--  A plain container for a block of content. Unlike AgCard this carries no
          border of its own, so callers can give it their own stroke (for
          example the caution panel on the Fast Flag editor page).  -->
    <Style x:Key="AgPanel" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,14" />
    </Style>

    <!--  Body copy for markdown blocks inside a panel.  -->
    <Style x:Key="AgDescription" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="AgCardLabel" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="AgCardValue" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,3,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="AgCardHint" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,5,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>

    <!--  =====  Controls  =====  -->

    <!--  Shared rounded, restrained controls keep every page on one visual system.
          BasedOn is required: without it this implicit style shadows
          WPF UI's Fluent button style, and buttons fall back to the classic WPF
          template (square corners, light-blue hover).  -->
    <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource DefaultUiButtonStyle}">
        <Setter Property="Appearance" Value="Secondary" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Border.CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="MinHeight" Value="34" />
        <Style.Triggers>
            <!--  Icon-only buttons (no text) are circular, with the glyph centred.  -->
            <Trigger Property="Content" Value="{x:Null}">
                <Setter Property="Border.CornerRadius" Value="999" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinWidth" Value="36" />
                <Setter Property="MinHeight" Value="36" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  Plain WPF buttons (dialogs, message boxes) inherit WPF UI's Fluent style too,
          so the whole app shares Bloxstrap's rounded buttons - icon-only ones included.  -->
    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Border.CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="MinHeight" Value="34" />
        <Style.Triggers>
            <Trigger Property="Content" Value="{x:Null}">
                <Setter Property="Border.CornerRadius" Value="999" />
                <Setter Property="Padding" Value="0" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AgActionButton" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Height" Value="40" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="AgButtonSubtle" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource AgActionButton}">
        <Setter Property="Appearance" Value="Secondary" />
    </Style>

    <Style TargetType="{x:Type ui:TitleBar}" BasedOn="{StaticResource {x:Type ui:TitleBar}}">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FontFamily" Value="{StaticResource Rubik}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style TargetType="{x:Type ui:CardAction}" BasedOn="{StaticResource DefaultUiCardActionStyle}">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="Border.CornerRadius" Value="10" />
    </Style>

    <Style x:Key="AgMono" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="AgDivider" TargetType="{x:Type Border}">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,18,0,0" />
        <Setter Property="Background" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    </Style>

    <!--  Severity accents. Used with a DataTrigger on the row's Severity value,
          so the colours still follow the active theme.  -->
    <Style x:Key="AgSeverityCritical" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
    </Style>

    <Style x:Key="AgSeverityCaution" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
    </Style>

    <Style x:Key="AgDisclosure" TargetType="{x:Type ui:CardExpander}" BasedOn="{StaticResource NoUserExpansionCardExpanderStyle}">
        <Setter Property="Border.CornerRadius" Value="10" />
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    </Style>

    <Style x:Key="AgCaption" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource AgBody}" />
    <Style x:Key="AgCardTitle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource AgCardLabel}" />
    <Style x:Key="AgTextBox" TargetType="{x:Type TextBox}" />

    <SolidColorBrush x:Key="AgAccent" Color="{DynamicResource SystemAccentColorPrimary}" />
    <SolidColorBrush x:Key="AgAccentSoft" Color="{DynamicResource SystemAccentColorSecondary}" />
    <SolidColorBrush x:Key="AgStroke" Color="{DynamicResource ControlStrokeColorDefault}" />
    <SolidColorBrush x:Key="AgSurfaceSunken" Color="{DynamicResource ControlFillColorSecondary}" />
    <SolidColorBrush x:Key="AgTextPrimary" Color="{DynamicResource TextFillColorPrimary}" />
    <SolidColorBrush x:Key="AgTextSecondary" Color="{DynamicResource TextFillColorSecondary}" />

    <Style x:Key="AgSeveritySuccess" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}" />
    </Style>

</ResourceDictionary>
